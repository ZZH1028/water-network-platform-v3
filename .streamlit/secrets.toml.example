# Paste into Streamlit Community Cloud -> Advanced settings -> Secrets.
# This example contains no working password or API key.
[platform]
PUBLIC_ADMIN_USERNAME = "admin"
# Set a unique password of at least 12 characters with letters and digits.
# Leave empty to keep management closed while public pages remain available.
PUBLIC_ADMIN_PASSWORD = ""
DEMO_MODE = true
SEED_DEMO_DATA = true

# Optional: external persistent database (otherwise hosting-local SQLite).
# DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE"

# Optional: compatible model settings. Keep keys in Secrets, not GitHub.
# WATER_AI_BASE_URL = "https://MODEL_SERVICE/v1"
# WATER_AI_MODEL = "MODEL_NAME"
# WATER_AI_API_KEY = ""
