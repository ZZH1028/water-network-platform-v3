# Optional local configuration. Existing process variables take precedence.
APP_ENV=development
DEMO_MODE=true
SEED_DEMO_DATA=true
APP_VERSION=V5.0 实景三维 · 水知助手

# Optional public, browser-readable HTTPS 3D Tiles URL; no backend API keys here.
WATER_3D_TILESET_URL=

# Optional OpenAI-compatible chat completions endpoint. No real key in this file.
WATER_AI_BASE_URL=
WATER_AI_MODEL=
WATER_AI_API_KEY=

# Leave unset to use storage/knowledge/knowledge.db.
# KNOWLEDGE_DB_PATH=/absolute/path/to/knowledge.db
